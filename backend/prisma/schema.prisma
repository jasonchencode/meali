generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id                 String   @id @default(cuid())
  equipment          String[]
  diets              String[]
  budgetLevel        String
  weeklyRunFrequency Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
